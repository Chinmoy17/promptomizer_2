# FDPO role-based model configuration.
# Copy to .env and fill in real values. Each role (solver / judge / optimizer)
# points at any OpenAI-compatible endpoint: OpenAI API, vLLM, Ollama, TGI,
# Together, DeepSeek API, ...

# --- Solver: the model being prompted (the one under test) ---
SOLVER_MODEL=gpt-4o-mini
SOLVER_BASE_URL=https://api.openai.com/v1
SOLVER_API_KEY=sk-REPLACE_ME

# --- Judge: verdict critique + section attribution ---
JUDGE_MODEL=gpt-4o
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=sk-REPLACE_ME

# --- Optimizer: rewrites prompt sections ---
OPTIMIZER_MODEL=gpt-4o
OPTIMIZER_BASE_URL=https://api.openai.com/v1
OPTIMIZER_API_KEY=sk-REPLACE_ME

# --- TAMU example (vLLM serving an open model on the cluster) ---
# SOLVER_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# SOLVER_BASE_URL=http://localhost:8000/v1
# SOLVER_API_KEY=dummy

# Optional: relocate the HuggingFace datasets cache
# HF_HOME=D:\hf_cache
